# Copy to repo-root .env (gitignored). Never commit .env.
#
# After binding custom domain (img.yourdomain.com), set (match hugo.toml params.imageCDN):
IMG_CDN_BASE=https://img.example.com
# Optional local-only: temporary r2.dev base from Dashboard — never commit the real URL
R2_BUCKET=dongli-blog-resources
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Optional: R2 API token for rclone / CI (create in Dashboard → R2 → Manage API tokens)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
